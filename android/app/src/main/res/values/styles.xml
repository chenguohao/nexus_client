<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LaunchTheme — applied to the launcher activity.

        Uses AndroidX Theme.SplashScreen so we get a uniform splash API
        across Android versions:
          • Pre-A12 (API ≤ 30): the activity's `windowBackground` is the
            splash; we set it to our full-screen Zeon header drawable
            so the user sees a pixel-perfect copy of ZeonWelcomePage.
          • A12+ (API ≥ 31): the OS forces its own splash mechanism —
            a centred icon (circle-clipped) on a coloured background.
            We feed it the Zeon dark colour and an icon containing
            the ZEON wordmark rendered with the same font / size /
            letter-spacing as ZeonWelcomePage. The subtitle and axis
            line cannot fit inside the 240 dp circular clip, so they
            are necessarily omitted on A12+.

        See lib/zeon/pages/welcome/zeon_welcome_page.dart for the
        reference typography that the splash assets mirror.
    -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <!-- Pre-A12 splash background = full-screen ZEON header bitmap. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- A12+ splash background colour. -->
        <item name="windowSplashScreenBackground">@color/zeon_background</item>
        <!-- A12+ splash icon = ZEON wordmark (matches welcome page font). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/android12splash</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        NormalTheme — Flutter switches the activity to this theme as
        soon as its first frame is rendered. Same dark colour as the
        welcome page so any sub-frame gap stays seamless.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/zeon_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
